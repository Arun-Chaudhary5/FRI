// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  name                  String?
  university            String?
  degree                String?
  department            String?
  expectedGraduation    String?
  email                 String?  @unique
  linkedin              String?
  github                String?
  portfolio             String?
  country               String?
  
  // Research Preferences
  preferredResearchAreas String?
  targetCountries        String?
  internshipDuration     String?
  preferredStartMonth    String?
  
  // Parsed AI CV Data (Stored as JSON stringified arrays)
  skills                String? 
  programmingLanguages  String? 
  frameworks            String? 
  researchExperience    String? 
  projects              String?
  leadershipRoles       String?
  awards                String?
  workExperience        String?
  publications          String?
  researchInterests     String?
  technicalStack        String?
  domainExpertise       String?
  
  // Relations
  professors            Professor[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Professor {
  id                    String   @id @default(cuid())
  
  // Basic Information
  name                  String?
  university            String?
  department            String?
  country               String?
  email                 String?
  emailStatus           String   @default("UNVERIFIED") // UNVERIFIED, VERIFIED_PUBLIC, PROVIDER_VERIFIED, NOT_FOUND
  emailSource           String?
  emailSourceUrl        String?
  emailConfidence       Int?
  emailLastChecked      DateTime?
  position              String?
  homepage              String?
  lab                   String?
  
  // Scraped Content (Raw Text)
  rawScrapedText        String?
  
  // Structured Research Info (JSON stringified)
  primaryAreas          String?
  currentThemes         String?
  keywords              String?
  openProblems          String?
  
  // Structured Publication Info (JSON stringified)
  latestPublications    String?
  mostCitedPublications String?
  topicsOverTime        String?
  
  // Lab Info (JSON stringified)
  currentProjects       String?
  collaborators         String?
  phdStudents           String?
  fundingSources        String?
  openPositions         String?
  
  // AI Research Analysis Summary
  aiAnalysisSummary     String?
  
  // CRM Tracking
  status                String   @default("UNCONTACTED") // UNCONTACTED, DRAFTED, SENT, REPLIED
  compatibilityScore    Int?
  compatibilityReasoning String?
  dateSent              DateTime?
  subject               String?
  tags                  String?
  notes                 String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
