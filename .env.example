# Database (PostgreSQL for prod/dev)
# For serverless environments (like Vercel), use a pooled connection string (e.g., Supabase transaction pool).
DATABASE_URL=""

# Direct connection for Prisma Migrations (only required if your DATABASE_URL uses a PgBouncer pool)
# DIRECT_URL=""

# Google OAuth (For Google Sign-In and Gmail Draft creation)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth Configuration
# Base URL of the application (e.g., http://localhost:3000 for dev, https://researchcopilot.vercel.app for prod)
NEXTAUTH_URL=https://your-site-url.com
# Generate a random secret via `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# API Providers
# Groq is required for CV parsing, research compatibility scoring, and AI analysis
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Serper is required for discovering professors (Auto-Discover)
SERPER_API_KEY=""

# Hunter is highly recommended for academic email discovery (Fallback)
HUNTER_API_KEY=""
